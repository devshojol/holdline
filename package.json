{
  "name": "holdline",
  "private": true,
  "version": "0.1.0",
  "description": "Holdline: a browser aim trainer where bots peek, swing and spray like real players. Babylon.js + React + TypeScript.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && tsc -p server && vite build",
    "preview": "vite preview",
    "server": "tsx server/index.ts",
    "server:dev": "tsx watch server/index.ts",
    "server:build": "esbuild server/index.ts --bundle --platform=node --target=node20 --format=cjs --external:bufferutil --external:utf-8-validate --outfile=dist-server/index.cjs",
    "server:start": "node dist-server/index.cjs",
    "mp:bot": "tsx server/tools/bot.ts",
    "typecheck": "tsc --noEmit && tsc -p server",
    "test": "vitest run",
    "build:single": "node scripts/build-single.mjs",
    "test:e2e": "node scripts/e2e.mjs"
  },
  "dependencies": {
    "@babylonjs/core": "^9.35.0",
    "@babylonjs/loaders": "9.35.0",
    "lucide-react": "^1.70.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "vercel": "^65.15.0",
    "ws": "^8.23.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.3.0",
    "esbuild": "^0.28.2",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
